# Android / Android Studio

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (contains paths to SDK on this specific machine)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio settings (machine-specific)
*.iml
.idea/
*.ipr
*.iws

# Keystore files (for signing release builds — these are secrets!)
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# Google Services (e.g. firebase) - sometimes contains API keys
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# OS-specific
.DS_Store
Thumbs.db
