<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== BUTTONS ==================== -->

    <!--
        Default Material button style, wired into Theme.RepsUp as
        materialButtonStyle. Every <Button>/<MaterialButton> without its own
        cornerRadius picks up radius_control automatically.
    -->
    <style name="Widget.RepsUp.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
        START button (Home, Calendar day list, My Plan). A real button, so it
        gets a ripple when tapped, with the same light-blue pill everywhere.
        Each layout sets its own width/height.
    -->
    <style name="Widget.RepsUp.Button.Start" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/light_blue</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:fontFamily">@font/orbitron_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!--
        Shared back-button style used on every screen with a back arrow
        (Login, Register, Settings, Account, Personal Details, Workout
        library, etc). 48dp touch target, 8dp padding, matching start/top
        margin, white tint and a borderless ripple. Pair with
        android:src="@drawable/ic_back".
    -->
    <style name="Widget.RepsUp.BackButton" parent="android:Widget">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/white</item>
    </style>

    <!-- ==================== INPUT FIELDS ==================== -->

    <!--
        Shared text-field style for Login, Register and Create Goal: transparent
        box, dark-grey stroke that turns light blue on focus, radius_control
        corners and a floating light-blue label. Wired into Theme.RepsUp as
        textInputStyle so every text field matches.
    -->
    <style name="Widget.RepsUp.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="hintTextColor">@color/light_blue</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <!--
        Same field look for exposed dropdown menus (admin muscle group /
        difficulty pickers), so dropdowns match every other text field.
    -->
    <style name="Widget.RepsUp.TextField.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="hintTextColor">@color/light_blue</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="endIconTint">@color/muted</item>
    </style>

    <!--
        Compact number box for set rows and sets/reps inputs (reps, weight,
        sets). Same outline look as Widget.RepsUp.TextField, no floating label:
        the column heading or label sits above it as plain text.
    -->
    <style name="Widget.RepsUp.CompactField" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_field_compact</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Compact number box inside a popup (darkest-grey background). -->
    <style name="Widget.RepsUp.CompactField.Popup">
        <item name="android:background">@drawable/bg_field_compact_popup</item>
    </style>

    <!-- ==================== TEXT STYLES ==================== -->

    <!--
        Widget style for page titles. Applied with style="..." rather than
        textAppearance so the theme's android:fontFamily (inter) can't override
        Orbitron on the title.
    -->
    <style name="Widget.RepsUp.PageTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/orbitron_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Page title variant that stays in normal case (greetings, user names) -->
    <style name="Widget.RepsUp.PageTitle.Personal" parent="Widget.RepsUp.PageTitle">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ==================== LOCKER TABS ==================== -->

    <!-- Locker main tab text style -->
    <style name="LockerTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Locker sub-tab text style -->
    <style name="LockerSubTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
