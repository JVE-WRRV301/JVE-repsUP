<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RepsUp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Background -->
        <item name="android:windowBackground">@color/dark_grey</item>
        <item name="colorPrimary">@color/light_blue</item>
        <item name="colorOnPrimary">@color/dark_grey</item>

        <!-- Surface -->
        <item name="colorSurface">@color/dark_grey_variant</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>

        <!-- Fonts -->
        <item name="android:fontFamily">@font/inter</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_grey</item>
    </style>
</resources>