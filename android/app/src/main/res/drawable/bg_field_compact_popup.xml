<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact number box for use inside popups, whose background is the darkest
    grey. Same as bg_field_compact, but the resting outline is a lighter grey
    so it stays visible on the popup. Light-blue outline while focused.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/light_blue" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/field_background" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
