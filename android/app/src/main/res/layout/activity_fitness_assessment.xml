<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assessmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_grey">

    <!-- Top bar: back button (step 0 only) + progress segments.
         Top padding comes from the status-bar inset at runtime, not a fixed value. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Back arrow for step 0 -->
        <ImageButton
            android:id="@+id/btnAssessmentBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/assessment_back"
            android:src="@drawable/ic_back"
            android:padding="12dp"
            android:visibility="visible"
            app:tint="@color/white" />

        <!-- Segmented progress bar container -->
        <LinearLayout
            android:id="@+id/llProgressSegments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ViewPager2 for step fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpAssessment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Navigation buttons -->
    <LinearLayout
        android:id="@+id/llBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/assessment_back"
            android:backgroundTint="@color/dark_grey_surface"
            android:textColor="@color/white"
            android:fontFamily="@font/inter"
            app:cornerRadius="28dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/assessment_next"
            android:backgroundTint="@color/light_blue"
            android:textColor="@color/dark_text"
            android:fontFamily="@font/inter"
            app:cornerRadius="28dp" />

    </LinearLayout>

</LinearLayout>
