<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_blue_border"
    android:padding="16dp">

    <!-- Workout name -->
    <TextView
        android:id="@+id/tvWorkoutCardName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/btnWorkoutMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3-dot menu button -->
    <ImageView
        android:id="@+id/btnWorkoutMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="-12dp"
        android:layout_marginEnd="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/workout_menu_description"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/muted" />

    <!-- Exercise count label -->
    <TextView
        android:id="@+id/tvWorkoutExerciseCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/muted"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWorkoutCardName" />

    <!-- Exercise preview container -->
    <LinearLayout
        android:id="@+id/llExercisePreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWorkoutExerciseCount" />

    <!-- "+N more" / "Show less": tap to expand or collapse the exercise list -->
    <TextView
        android:id="@+id/tvWorkoutMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/inter"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:textColor="@color/light_blue"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llExercisePreview" />

</androidx.constraintlayout.widget.ConstraintLayout>
