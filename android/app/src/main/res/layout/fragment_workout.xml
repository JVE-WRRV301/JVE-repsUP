<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:orientation="vertical"
    tools:context="com.jve.repsup.fragments.WorkoutFragment">

    <!-- Header with title and add button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvWorkoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/tab_workout"
            android:textColor="@color/white"
            style="@style/Widget.RepsUp.PageTitle" />

        <ImageView
            android:id="@+id/btnAddWorkout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/workout_add_description"
            android:padding="4dp"
            android:src="@drawable/ic_add_circle"
            app:tint="@color/light_blue" />

    </RelativeLayout>

    <!-- TabLayout for Saved / Library / Default -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_grey"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/light_blue"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/light_blue"
        app:tabTextColor="@color/muted" />

    <!-- Content area for Saved tab -->
    <FrameLayout
        android:id="@+id/flSavedContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedWorkouts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvSavedEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter"
            android:text="@string/workout_saved_empty"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Content area for Default tab (admin workouts, view only) -->
    <FrameLayout
        android:id="@+id/flDefaultContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDefaultWorkouts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvDefaultEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter"
            android:text="@string/workout_default_empty"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Content area for Library tab -->
    <FrameLayout
        android:id="@+id/flLibraryContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <!-- Muscle group grid view -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMuscleGroups"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <!-- Exercise list (shown after tapping a muscle group) -->
        <LinearLayout
            android:id="@+id/llExerciseListContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Back button to return to muscle group grid -->
            <LinearLayout
                android:id="@+id/llLibraryBackRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/btnLibraryBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/workout_back_description"
                    android:src="@drawable/ic_back"
                    app:tint="@color/light_blue" />

                <TextView
                    android:id="@+id/tvLibraryGroupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExerciseList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="16dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
