<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Rounded card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_goal_complete_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvLevelUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_bold"
            android:text="@string/level_up_title"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <!-- Bicep icon (replaces the old emoji) -->
        <ImageView
            android:id="@+id/ivLevelUpIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/level_up_title"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bicep" />

        <!-- New level number -->
        <TextView
            android:id="@+id/tvNewLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/orbitron_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <!-- Coins earned -->
        <TextView
            android:id="@+id/tvCoinsEarned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/orbitron"
            android:text="@string/level_up_coins"
            android:textColor="@color/yellow"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Close button -->
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card_blue_border"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:text="@string/level_up_close"
        android:textColor="@color/white"
        android:textSize="14sp" />

</LinearLayout>
