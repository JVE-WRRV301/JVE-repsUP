<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/placeholder_container"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_placeholder_item">

        <!-- Item image (fills most of the cell so the user can see the garment) -->
        <ImageView
            android:id="@+id/img_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Cosmetic item"
            tools:src="@drawable/ic_launcher_foreground" />

    </LinearLayout>

    <!-- Lock overlay with price (visible only for locked items).
         Dims the cell but keeps the garment visible; the lock sits top-start and
         the price sits bottom-center so the user can still see what they're buying. -->
    <FrameLayout
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_placeholder_locked"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Locked"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="Coins" />

            <TextView
                android:id="@+id/txt_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/yellow"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="50" />

        </LinearLayout>

    </FrameLayout>

    <!-- Selected indicator -->
    <ImageView
        android:id="@+id/img_selected_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:src="@drawable/ic_check"
        android:contentDescription="Selected"
        android:visibility="gone" />

</FrameLayout>
