<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/dark_grey">

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_section_fitness"
        android:textColor="@color/muted"
        android:fontFamily="@font/inter"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_workout_level_question"
        android:textColor="@color/white"
        android:fontFamily="@font/orbitron"
        android:textSize="22sp"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnNever"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/assessment_level_never"
        android:backgroundTint="@color/dark_grey_surface"
        android:textColor="@color/white"
        android:fontFamily="@font/inter"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnBeginner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/assessment_level_beginner"
        android:backgroundTint="@color/dark_grey_surface"
        android:textColor="@color/white"
        android:fontFamily="@font/inter"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnIntermediate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/assessment_level_intermediate"
        android:backgroundTint="@color/dark_grey_surface"
        android:textColor="@color/white"
        android:fontFamily="@font/inter"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnAdvanced"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/assessment_level_advanced"
        android:backgroundTint="@color/dark_grey_surface"
        android:textColor="@color/white"
        android:fontFamily="@font/inter"
        android:textSize="16sp" />

</LinearLayout>
