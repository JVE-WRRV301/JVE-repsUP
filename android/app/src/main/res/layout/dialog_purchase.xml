<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_purchase_dialog"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Item image -->
    <ImageView
        android:id="@+id/img_purchase_item"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_placeholder_item"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/purchase_item_description"
        tools:src="@drawable/ic_launcher_foreground" />

    <!-- Item name -->
    <TextView
        android:id="@+id/txt_purchase_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Blue Top" />

    <!-- Price display with coin icon -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_coin"
            android:contentDescription="@string/coins_description" />

        <TextView
            android:id="@+id/txt_purchase_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/yellow"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="150" />

    </LinearLayout>

    <!-- Not enough coins message (hidden by default) -->
    <TextView
        android:id="@+id/txt_insufficient_coins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/locker_not_enough_coins"
        android:textColor="@color/red"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <!-- Cancel button -->
        <android.widget.Button
            android:id="@+id/btn_purchase_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_cancel"
            android:text="@string/purchase_cancel"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textAllCaps="false" />

        <!-- Buy button -->
        <android.widget.Button
            android:id="@+id/btn_purchase_buy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_buy"
            android:text="@string/purchase_buy"
            android:textColor="@color/dark_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
