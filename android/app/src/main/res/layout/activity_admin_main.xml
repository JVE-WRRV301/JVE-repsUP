<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/adminMainRoot"
    android:background="@color/dark_grey"
    android:padding="32dp">

    <!-- Pushes the title down so it clears the status bar and sits lower on the screen -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.2" />

    <!-- Admin Dashboard Title -->
    <TextView
        android:id="@+id/tvAdminDashboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_dashboard_title"
        android:textColor="@color/white"
        style="@style/Widget.RepsUp.PageTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideTop" />

    <!-- Create Default Workout -->
    <Button
        android:id="@+id/btnCreateWorkout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/light_blue"
        android:fontFamily="@font/inter_bold"
        android:text="@string/admin_create_workout"
        android:textColor="@color/dark_text"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminDashboardTitle" />

    <!-- Create Default Exercise -->
    <Button
        android:id="@+id/btnCreateExercise"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/light_blue"
        android:fontFamily="@font/inter_bold"
        android:text="@string/admin_create_exercise"
        android:textColor="@color/dark_text"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateWorkout" />

    <!-- Manage Default Workouts -->
    <Button
        android:id="@+id/btnManageWorkouts"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/light_blue"
        android:fontFamily="@font/inter_bold"
        android:text="@string/admin_manage_workouts"
        android:textColor="@color/dark_text"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateExercise" />

    <!-- Logout -->
    <Button
        android:id="@+id/btnAdminLogout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/inter_bold"
        android:text="@string/admin_logout"
        android:textColor="@color/red"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnManageWorkouts" />

</androidx.constraintlayout.widget.ConstraintLayout>
