<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llTopBar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/dark_grey_variant"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Avatar thumbnail -->
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/avatar_description"
        android:src="@drawable/ic_avatar_placeholder" />

    <!-- Level indicator -->
    <ImageView
        android:id="@+id/ivLevelBadge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/level_description"
        android:src="@drawable/ic_level_badge" />

    <TextView
        android:id="@+id/tvLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/orbitron"
        android:textColor="@color/light_blue"
        android:textSize="14sp"
        tools:text="5" />

    <!-- Spacer -->
    <android.view.View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Streak fire icon with count -->
    <ImageView
        android:id="@+id/ivStreak"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/streak_description"
        android:src="@drawable/ic_streak_fire" />

    <TextView
        android:id="@+id/tvStreakCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="7" />

    <!-- Coin icon with count -->
    <ImageView
        android:id="@+id/ivCoin"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        android:contentDescription="@string/coins_description"
        android:src="@drawable/ic_coin" />

    <TextView
        android:id="@+id/tvCoinCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/yellow"
        android:textSize="14sp"
        tools:text="150" />

</LinearLayout>
