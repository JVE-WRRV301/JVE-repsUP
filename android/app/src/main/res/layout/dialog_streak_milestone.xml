<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <!-- Card with blue border -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_streak_milestone_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Congratulations title -->
        <TextView
            android:id="@+id/tvMilestoneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_bold"
            android:gravity="center"
            android:text="@string/streak_milestone_congrats"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvMilestoneSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- XP Multiplier Activated -->
        <TextView
            android:id="@+id/tvXpActivated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/orbitron_bold"
            android:gravity="center"
            android:text="@string/streak_milestone_xp_activated"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Fire icon -->
        <ImageView
            android:id="@+id/ivFireIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/streak_milestone_fire_desc"
            android:src="@drawable/ic_fire_large"
            app:tint="@color/red" />

        <!-- X DAY STREAK -->
        <TextView
            android:id="@+id/tvStreakCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/orbitron_bold"
            android:textColor="@color/red"
            android:textSize="16sp" />

        <!-- xMultiplierXP -->
        <TextView
            android:id="@+id/tvXpMultiplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/orbitron_bold"
            android:textColor="@color/yellow"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Bottom buttons (share + close) floating below the card -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal">

        <!-- Share button -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_circle_muted"
            android:contentDescription="@string/streak_milestone_share"
            android:src="@drawable/ic_share"
            app:tint="@color/white" />

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_muted"
            android:contentDescription="@string/streak_milestone_close"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

    </LinearLayout>

</FrameLayout>
