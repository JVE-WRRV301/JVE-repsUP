<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/generate_workout_title"
        android:textColor="@color/white"
        style="@style/Widget.RepsUp.PageTitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter"
        android:text="@string/generate_workout_difficulty_label"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <!-- Difficulty options span the full width, evenly split three ways. They use
         the app's shared selectable-button look (SelectableButtonStyler), and the
         fragment manages single selection. -->
    <LinearLayout
        android:id="@+id/difficultyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDifficultyEasy"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/dark_grey_surface"
            android:fontFamily="@font/inter"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/difficulty_easy"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDifficultyMedium"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/dark_grey_surface"
            android:fontFamily="@font/inter"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/difficulty_medium"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDifficultyHard"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_grey_surface"
            android:fontFamily="@font/inter"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/difficulty_hard"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter"
        android:text="@string/generate_workout_muscle_groups_label"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMuscleGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/light_blue"
        android:fontFamily="@font/inter_bold"
        android:text="@string/generate_workout_button"
        android:textColor="@color/dark_text"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control" />

</LinearLayout>
