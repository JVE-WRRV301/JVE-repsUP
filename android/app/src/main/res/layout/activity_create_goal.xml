<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/orbitron_bold"
            android:text="@string/create_goal_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Goal Title Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalTitle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            app:boxStrokeColor="@color/light_blue"
            app:hintTextColor="@color/light_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/hint_goal_title"
                android:inputType="textCapSentences"
                android:textColor="@color/white"
                android:textColorHint="@color/muted" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date Picker Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalDate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:boxStrokeColor="@color/light_blue"
            app:hintTextColor="@color/light_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilGoalTitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/hint_goal_date"
                android:inputType="none"
                android:textColor="@color/white"
                android:textColorHint="@color/muted" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Importance Label -->
        <TextView
            android:id="@+id/tvImportanceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/inter_regular"
            android:text="@string/label_goal_importance"
            android:textColor="@color/muted"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilGoalDate" />

        <!-- Importance Buttons Row -->
        <LinearLayout
            android:id="@+id/llImportanceButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvImportanceLabel">

            <Button
                android:id="@+id/btnImportanceTop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dark_grey_surface"
                android:fontFamily="@font/inter_bold"
                android:text="@string/importance_top"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnImportanceMedium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dark_grey_surface"
                android:fontFamily="@font/inter_bold"
                android:text="@string/importance_medium"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnImportanceLow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dark_grey_surface"
                android:fontFamily="@font/inter_bold"
                android:text="@string/importance_low"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Notes Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalNotes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            app:boxStrokeColor="@color/light_blue"
            app:hintTextColor="@color/light_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llImportanceButtons">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:gravity="top"
                android:hint="@string/hint_goal_notes"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:textColor="@color/white"
                android:textColorHint="@color/muted" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Error Text -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilGoalNotes" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/light_blue"
            android:fontFamily="@font/inter_bold"
            android:text="@string/btn_save_goal"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvError" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
