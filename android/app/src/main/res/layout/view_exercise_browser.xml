<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditText
        android:id="@+id/etExerciseSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_field"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/muted"
        android:fontFamily="@font/inter"
        android:hint="@string/exercise_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />

    <!-- One tab per muscle group; hidden while a search is active -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabMuscleGroups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/dark_grey"
        app:tabIndicatorColor="@color/light_blue"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/light_blue"
        app:tabTextColor="@color/muted" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBrowserExercises"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvBrowserEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter"
            android:text="@string/exercise_browser_no_results"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</merge>
