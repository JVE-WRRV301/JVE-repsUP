<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:orientation="vertical"
    tools:context="com.jve.repsup.fragments.CalendarFragment">

    <!-- Month navigation header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivPrevMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/calendar_prev_month"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/orbitron"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:text="January 2025" />

        <ImageView
            android:id="@+id/ivNextMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/calendar_next_month"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Day of week headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_sun"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_mon"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_tue"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_wed"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_thu"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_fri"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_sat"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Calendar grid (RecyclerView with GridLayoutManager) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendarGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <!-- Selected day content area -->
    <LinearLayout
        android:id="@+id/llDayContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedDayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Tab layout for My Plan / Goals -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/dark_grey"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/light_blue"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/light_blue"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabTextColor="@color/muted" />

    <!-- Tab content container -->
    <FrameLayout
        android:id="@+id/flTabContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- FAB for adding schedule / goal -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:contentDescription="@string/calendar_add_action"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/light_blue"
        app:tint="@color/dark_text" />

</LinearLayout>
