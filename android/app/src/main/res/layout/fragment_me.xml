<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    tools:context="com.jve.repsup.fragments.MeFragment">

    <!-- Name + @username title (top-left) -->
    <LinearLayout
        android:id="@+id/llMeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.RepsUp.PageTitle.Personal"
            tools:text="Emma" />

        <TextView
            android:id="@+id/tvMeUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="@color/muted"
            android:textSize="14sp"
            tools:text="@emma" />
    </LinearLayout>

    <!-- Settings gear icon top-right -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:src="@drawable/ic_gear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/muted" />

    <!-- Avatar card (same margins as GYM RANK card below) -->
    <FrameLayout
        android:id="@+id/cardAvatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_dark"
        app:layout_constraintBottom_toTopOf="@id/cardGymRank"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llMeTitle">

        <!-- Full-body avatar display -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/avatar_description"
            android:scaleType="fitCenter" />

        <!-- Shop icon in bottom-right corner -->
        <ImageButton
            android:id="@+id/btnLocker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/me_locker_description"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shop" />
    </FrameLayout>

    <!-- GYM RANK card at bottom -->
    <LinearLayout
        android:id="@+id/cardGymRank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- GYM RANK title -->
        <TextView
            android:id="@+id/tvGymRankTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/orbitron_bold"
            android:text="@string/me_gym_rank_title"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <!-- Rank medal + Level circle row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rank medal section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Medal icon with border -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_rank_medal_border"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivMedal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@string/me_rank_description"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_medal" />
                </FrameLayout>

                <!-- Rank name below medal -->
                <TextView
                    android:id="@+id/tvRankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/burnt_orange"
                    android:textSize="14sp"
                    tools:text="BRONZE II" />
            </LinearLayout>

            <!-- Level circle section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Grey circle with blue progress ring and level number -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <!-- Light grey circle background -->
                    <View
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_level_circle_grey" />

                    <!-- Circular XP progress indicator -->
                    <ProgressBar
                        android:id="@+id/pbLevelProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="50"
                        android:progressDrawable="@drawable/circular_level_progress" />

                    <!-- Level number in center -->
                    <TextView
                        android:id="@+id/tvLevelNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/orbitron_bold"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        tools:text="10" />
                </FrameLayout>

                <!-- "LEVEL X" label below circle -->
                <TextView
                    android:id="@+id/tvLevelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/light_blue"
                    android:textSize="14sp"
                    tools:text="LEVEL 10" />

                <!-- XP progress text -->
                <TextView
                    android:id="@+id/tvXpProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    tools:text="250 / 500 XP" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
