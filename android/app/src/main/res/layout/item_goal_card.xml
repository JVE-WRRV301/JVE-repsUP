<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_red_border"
    android:padding="16dp">

    <!-- Deadline (e.g. "15 Sunday") -->
    <TextView
        android:id="@+id/tvGoalDeadline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:textColor="@color/muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/btnGoalMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3-dot menu button -->
    <ImageView
        android:id="@+id/btnGoalMenu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/goal_menu_description"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/muted" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvGoalTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalDeadline" />

    <!-- Priority badge -->
    <TextView
        android:id="@+id/tvGoalPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalTitle" />

    <!-- Notes / Description -->
    <TextView
        android:id="@+id/tvGoalDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter"
        android:maxLines="3"
        android:textColor="@color/muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/cbGoalComplete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalPriority" />

    <!-- Completion checkbox - bottom right -->
    <CheckBox
        android:id="@+id/cbGoalComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/muted"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalPriority" />

</androidx.constraintlayout.widget.ConstraintLayout>
