<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:fillViewport="true"
    tools:context="com.jve.repsup.fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Greeting title -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/Widget.RepsUp.PageTitle.Personal"
            tools:text="Good morning, Emma" />

        <!-- Week Strip -->
        <LinearLayout
            android:id="@+id/llWeekStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp">

            <!-- Sunday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelSun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_sun"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateSun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Monday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelMon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_mon"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateMon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Tuesday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelTue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_tue"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateTue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Wednesday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelWed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_wed"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateWed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Thursday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelThu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_thu"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateThu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Friday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelFri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_fri"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateFri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Saturday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tvDayLabelSat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_sat"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDayDateSat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/muted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- TODAY Card -->
        <LinearLayout
            android:id="@+id/cardToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_blue_border"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <!-- Card Header -->
            <TextView
                android:id="@+id/tvTodayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_today"
                android:fontFamily="@font/orbitron_bold"
                android:textColor="@color/light_blue"
                android:textSize="12sp" />

            <!-- Workout Content (visible when workout exists) -->
            <LinearLayout
                android:id="@+id/llTodayContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvWorkoutName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvWorkoutDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <!-- Exercise List Container -->
                <LinearLayout
                    android:id="@+id/llExerciseList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />

                <!-- START Button -->
                <TextView
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_start_button"
                    android:fontFamily="@font/orbitron_bold"
                    android:gravity="center"
                    android:text="@string/home_start"
                    android:textColor="@color/dark_text"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Empty State (visible on rest days) -->
            <TextView
                android:id="@+id/tvTodayEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:fontFamily="@font/inter"
                android:text="@string/home_rest_day"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:paddingVertical="24dp" />

        </LinearLayout>

        <!-- NEXT GOAL Card -->
        <LinearLayout
            android:id="@+id/cardGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_red_border"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <!-- Card Header -->
            <TextView
                android:id="@+id/tvGoalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_next_goal"
                android:fontFamily="@font/orbitron_bold"
                android:textColor="@color/red"
                android:textSize="12sp" />

            <!-- Goal Content (visible when goal exists) -->
            <LinearLayout
                android:id="@+id/llGoalContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvGoalDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvGoalTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/orbitron_bold"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvGoalPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_priority_badge"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/light_blue"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvGoalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:maxLines="3"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Empty State (visible when no goals) -->
            <TextView
                android:id="@+id/tvGoalEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:fontFamily="@font/inter"
                android:text="@string/home_no_goals"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:paddingVertical="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
