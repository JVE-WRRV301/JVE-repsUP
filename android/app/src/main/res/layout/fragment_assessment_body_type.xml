<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assessment_section_body"
            android:textColor="@color/muted"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assessment_body_type_question"
            android:textColor="@color/white"
            android:fontFamily="@font/orbitron"
            android:textSize="22sp"
            android:layout_marginTop="24dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assessment_body_type_subtitle"
            android:textColor="@color/muted"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <!-- Three body-type options, stacked one per row -->
        <LinearLayout
            android:id="@+id/llBodyTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/ivBodyType0"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_bodytype_background"
                android:foreground="@drawable/bg_bodytype_unselected"
                android:clipToOutline="true"
                android:contentDescription="@string/assessment_body_average" />

            <ImageView
                android:id="@+id/ivBodyType1"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_bodytype_background"
                android:foreground="@drawable/bg_bodytype_unselected"
                android:clipToOutline="true"
                android:contentDescription="@string/assessment_body_toned" />

            <ImageView
                android:id="@+id/ivBodyType2"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_bodytype_background"
                android:foreground="@drawable/bg_bodytype_unselected"
                android:clipToOutline="true"
                android:contentDescription="@string/assessment_body_chubby" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
