<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assessment_section_body"
            android:textColor="@color/muted"
            android:fontFamily="@font/inter"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assessment_body_type_question"
            android:textColor="@color/white"
            android:fontFamily="@font/orbitron"
            android:textSize="22sp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assessment_body_type_subtitle"
            android:textColor="@color/muted"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- 2x3 Grid of body type images -->
        <GridLayout
            android:id="@+id/glBodyTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:rowCount="3"
            android:alignmentMode="alignBounds">

            <!-- Row 1 -->
            <ImageView
                android:id="@+id/ivBodyType0"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_bodytype_unselected"
                android:padding="4dp"
                android:clipToPadding="true"
                android:contentDescription="@string/assessment_body_skinny" />

            <ImageView
                android:id="@+id/ivBodyType1"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_bodytype_unselected"
                android:padding="4dp"
                android:clipToPadding="true"
                android:contentDescription="@string/assessment_body_average" />

            <!-- Row 2 -->
            <ImageView
                android:id="@+id/ivBodyType2"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_bodytype_unselected"
                android:padding="4dp"
                android:clipToPadding="true"
                android:contentDescription="@string/assessment_body_toned" />

            <ImageView
                android:id="@+id/ivBodyType3"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_bodytype_unselected"
                android:padding="4dp"
                android:clipToPadding="true"
                android:contentDescription="@string/assessment_body_muscular" />

            <!-- Row 3 -->
            <ImageView
                android:id="@+id/ivBodyType4"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_bodytype_unselected"
                android:padding="4dp"
                android:clipToPadding="true"
                android:contentDescription="@string/assessment_body_chubby" />

            <ImageView
                android:id="@+id/ivBodyType5"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_bodytype_unselected"
                android:padding="4dp"
                android:clipToPadding="true"
                android:contentDescription="@string/assessment_body_overweight" />

        </GridLayout>

    </LinearLayout>

</ScrollView>
