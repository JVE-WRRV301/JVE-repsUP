<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/dark_grey">

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_section_body"
        android:textColor="@color/muted"
        android:fontFamily="@font/inter"
        android:textSize="14sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_weight_question"
        android:textColor="@color/white"
        android:fontFamily="@font/orbitron"
        android:textSize="22sp"
        android:layout_marginTop="24dp"
        android:gravity="center" />

    <!-- Unit toggle -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKg"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="@string/assessment_unit_kg"
            android:backgroundTint="@color/light_blue"
            android:textColor="@color/dark_text"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            app:cornerRadius="@dimen/radius_control" />

        <Button
            android:id="@+id/btnLbs"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="@string/assessment_unit_lbs"
            android:backgroundTint="@color/dark_grey_surface"
            android:textColor="@color/white"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            app:cornerRadius="@dimen/radius_control" />

    </LinearLayout>

    <!-- Weight value display with underline -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|center_horizontal"
        android:layout_marginTop="40dp">

        <EditText
            android:id="@+id/etWeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/white"
            android:fontFamily="@font/orbitron"
            android:textSize="52sp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="3"
            android:minWidth="100dp"
            android:text="70" />

        <TextView
            android:id="@+id/tvWeightUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assessment_unit_kg"
            android:textColor="@color/muted"
            android:fontFamily="@font/inter"
            android:textSize="24sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Blue underline -->
    <View
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:background="@color/light_blue" />

    <!-- Ruler slider -->
    <com.jve.repsup.utils.RulerSliderView
        android:id="@+id/rulerSlider"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="32dp" />

</LinearLayout>
