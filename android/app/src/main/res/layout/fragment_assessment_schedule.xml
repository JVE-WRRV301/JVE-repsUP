<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/dark_grey">

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_section_fitness"
        android:textColor="@color/muted"
        android:fontFamily="@font/inter"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_schedule_question"
        android:textColor="@color/white"
        android:fontFamily="@font/orbitron"
        android:textSize="22sp"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvScheduleValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="3"
        android:textColor="@color/light_blue"
        android:fontFamily="@font/orbitron"
        android:textSize="48sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvScheduleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_schedule_days_per_week"
        android:textColor="@color/muted"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        android:gravity="center" />

    <SeekBar
        android:id="@+id/sbSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:min="1"
        android:max="7"
        android:progress="2"
        android:progressTint="@color/light_blue"
        android:thumbTint="@color/light_blue"
        android:progressBackgroundTint="@color/dark_grey_surface" />

</LinearLayout>
