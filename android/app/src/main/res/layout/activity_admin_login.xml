<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:padding="32dp">

    <!-- Admin Login Title -->
    <TextView
        android:id="@+id/tvAdminTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_login_title"
        android:textColor="@color/white"
        style="@style/Widget.RepsUp.PageTitle"
        app:layout_constraintBottom_toTopOf="@id/tilAdminUsername"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Username Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAdminUsername"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:boxStrokeColor="@color/light_blue"
        app:boxCornerRadiusTopStart="@dimen/radius_control"
        app:boxCornerRadiusTopEnd="@dimen/radius_control"
        app:boxCornerRadiusBottomStart="@dimen/radius_control"
        app:boxCornerRadiusBottomEnd="@dimen/radius_control"
        app:hintTextColor="@color/light_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdminUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:hint="@string/admin_username_hint"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAdminPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="@color/light_blue"
        app:boxCornerRadiusTopStart="@dimen/radius_control"
        app:boxCornerRadiusTopEnd="@dimen/radius_control"
        app:boxCornerRadiusBottomStart="@dimen/radius_control"
        app:boxCornerRadiusBottomEnd="@dimen/radius_control"
        app:hintTextColor="@color/light_blue"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/light_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilAdminUsername">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdminPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:hint="@string/admin_password_hint"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:textColorHint="@color/muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Error Message -->
    <TextView
        android:id="@+id/tvAdminError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/red"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilAdminPassword" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btnAdminLogin"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/light_blue"
        android:fontFamily="@font/inter_bold"
        android:text="@string/admin_login_button"
        android:textColor="@color/dark_text"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminError" />

</androidx.constraintlayout.widget.ConstraintLayout>
