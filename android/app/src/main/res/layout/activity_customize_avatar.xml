<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_grey"
    tools:context=".activities.CustomizeAvatarActivity">

    <!-- Top bar: back button, title, coin balance, save button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/dark_grey_variant">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LOCKER"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Coin balance -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="Coins" />

            <TextView
                android:id="@+id/txt_coin_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/yellow"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1250" />

        </LinearLayout>

        <!-- Save button -->
        <ImageButton
            android:id="@+id/btn_save"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_check"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save outfit" />

    </LinearLayout>

    <!-- Avatar preview area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_avatar_preview"
        android:layout_margin="16dp">

        <ImageView
            android:id="@+id/img_avatar_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:contentDescription="Avatar preview" />

    </FrameLayout>

    <!-- Category tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_categories"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/dark_grey_variant"
        app:tabTextColor="@color/muted"
        app:tabSelectedTextColor="@color/light_blue"
        app:tabIndicatorColor="@color/light_blue"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- Grid of cosmetic items -->
    <GridView
        android:id="@+id/grid_cosmetics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:verticalSpacing="8dp"
        android:horizontalSpacing="8dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:stretchMode="columnWidth" />

</LinearLayout>
