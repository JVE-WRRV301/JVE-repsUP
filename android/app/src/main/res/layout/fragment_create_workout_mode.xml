<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        android:text="@string/create_workout_title"
        android:textColor="@color/white"
        style="@style/Widget.RepsUp.PageTitle" />

    <Button
        android:id="@+id/btnCreateMode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/light_blue"
        android:fontFamily="@font/inter_bold"
        android:text="@string/create_workout_mode_create"
        android:textColor="@color/dark_text"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/create_workout_mode_create_desc"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnGenerateMode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/dark_grey_surface"
        android:fontFamily="@font/inter_bold"
        android:text="@string/create_workout_mode_generate"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_control" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/create_workout_mode_generate_desc"
        android:textColor="@color/muted"
        android:textSize="13sp" />

</LinearLayout>
