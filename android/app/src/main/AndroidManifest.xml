            android:exported="false" />
        <activity
            android:name=".activities.CreateGoalActivity"
            android:exported="false" />
        <activity
            android:name=".activities.WorkoutExecutionActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AdminMainActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AdminCreateWorkoutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AdminCreateExerciseActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AdminManageWorkoutsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.CreateWorkoutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ScheduleWorkoutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.WorkoutCompleteActivity"
            android:exported="false" />
    </application>

</manifest>
